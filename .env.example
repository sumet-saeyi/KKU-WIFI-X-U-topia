# Server-only live U-Bot connection. Offline practice needs no credentials.
# Use a rotated password. Never commit account credentials or NEXT_PUBLIC_ secrets.
UBOT_EMAIL=
UBOT_PASSWORD=
UBOT_TESTER_ID=
UBOT_MODE=fast
# Optional: public Supabase anon/publishable key; otherwise discover the matching
# anonymous key from u.bot's public bundles. Never use a service-role key.
UBOT_SUPABASE_ANON_KEY=
# Optional alternative/fallback: an existing U-Bot access token.
UBOT_BEARER_TOKEN=

# ElevenLabs speech, based on the supplied ElevenLabs Hacker Guide.
# eleven_v3 supports English, Thai and Spanish. If a v2 model is configured,
# Thai requests automatically use eleven_v3 instead.
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL_ID=eleven_v3
# Working example voice from the ElevenLabs SDK guide; do not use a voice name or a made-up ID.
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
# Optional voice overrides for the selected language.
ELEVENLABS_VOICE_ID_EN=
ELEVENLABS_VOICE_ID_TH=
ELEVENLABS_VOICE_ID_ES=

# Optional: deployed UIkigaiVault address on Fuji for the mentor-only wallet inspector.
# USD amounts in this integration are stored as cents (100 USD = 10000).
NEXT_PUBLIC_VAULT_ADDRESS=
